<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body dir="rtl">
    <div class="container">
      <h1 id="score">امتیاز شما:‌ <%= userScore %></h1>
      <h1>شهر را حدس بزنید!</h1>
      <h2><%= randomDistrict%></h2>

      <form action="/check" method="POST">
        <input type="hidden" value="<%= randomDistrict %>" name="district" />
        <input
          type="text"
          name="cityInput"
          id=""
          placeholder="حدس تان را وارد نمایید!"
        />
        <button type="submit" name="action" value="check">بررسی</button>
        <button type="submit" name="action" value="hint">راهنما</button>
      </form>
      <% if(hintRegion) { %>
      <p id="hint">این ناحیه مربوط به منطقه <%= hintRegion%> میشود.</p>
      <%}%>
    </div>
  </body>
</html>
